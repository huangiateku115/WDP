NODE_ENV=development
PORT=3000
# MI-06 stock-ledger writes are disabled until a later approved phase.
MI06_STOCK_LEDGER_WRITES_ENABLED=false
MI06_REPEATED_INBOUND_ENABLED=false
MI06_CANONICAL_OUTBOUND_REQUESTS_ENABLED=false
MI06_CANONICAL_OUTBOUND_CONFIRMATIONS_ENABLED=false
MI06_CANONICAL_RELOCATIONS_ENABLED=false
# Comma-separated exact frontend origins, no paths/trailing slashes.
# Add your staging frontend origin in the hosting environment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MONGO_URL=<shared-mongodb-atlas-development-uri>
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=wdp-realm
KEYCLOAK_CLIENT_ID=wdp-backend
KEYCLOAK_CLIENT_SECRET=replace-with-local-development-client-secret
KEYCLOAK_ISSUER=http://localhost:8081/realms/wdp-realm
KEYCLOAK_JWKS_URI=http://localhost:8081/realms/wdp-realm/protocol/openid-connect/certs
# Backend-only Cloudinary credentials. Never copy CLOUDINARY_API_SECRET into frontend/.env.
CLOUDINARY_CLOUD_NAME=<development-cloud-name>
CLOUDINARY_API_KEY=<development-api-key>
CLOUDINARY_API_SECRET=<development-api-secret>
# backend/.env
PAYOS_CLIENT_ID=your_client_id
PAYOS_API_KEY=your_api_key
PAYOS_CHECKSUM_KEY=your_checksum_key
PAYOS_ENABLED=false
PAYOS_CUSTOMER_ORIGIN=https://your-customer-domain.example
PAYOS_WEBHOOK_URL=https://your-api.example/api/v1/payments/payos/webhook
